SECRET_KEY=replace-with-a-long-random-secret-key


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


LLM_PROVIDER=gemini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
