DATABASE_URL=mysql+pymysql://user:password@host:3306/database

SECRET_KEY=replace-with-a-long-random-secret-key


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


LLM_PROVIDER=groq

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

LLM_TIMEOUT_SECONDS=45


COMPANY_EVALUATION_TIMEOUT_SECONDS=240
COMPANY_EVALUATION_BATCH_SIZE=20
COMPANY_EVALUATION_MAX_RETRIES=5
COMPANY_EVALUATION_REFERENCE_MAX_CHARS=1500
COMPANY_EVALUATION_USER_MAX_CHARS=2500


VECTOR_DB_PATH=./data/vector_db
QDRANT_COLLECTION=dsa_corpus
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180


CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
